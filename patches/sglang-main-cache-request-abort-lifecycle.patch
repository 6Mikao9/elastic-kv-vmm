+++ b/python/sglang/srt/mem_cache/common.py
@@ -15,6 +15,7 @@ from sglang.srt.environ import envs
 from sglang.srt.mem_cache.allocator.page_interleave import page_interleave_shard_size
 from sglang.srt.mem_cache.base_prefix_cache import (
     BasePrefixCache,
+    CacheRequestOutcome,
     EvictParams,
     MatchPrefixParams,
     MatchResult,
@@ -392,6 +393,29 @@ def discard_kv_cache_backup(
     req.kv.retraction_backup = None
 
 
+def abort_prefix_cache_request(
+    req: Req,
+    tree_cache: BasePrefixCache,
+    *,
+    release_kv: bool = False,
+    checkpoint: bool = False,
+) -> None:
+    """Cancel abort-phase work, optionally release KV, then close the session.
+
+    FlexKV must cancel lookup/prefetch before KV finalization so an
+    asynchronous STORE retains its source-node lock. LMCache must close its
+    session after that optional STORE, or immediately when no STORE runs.
+    """
+    handle = req.cache_request_handle
+    tree_cache.finish(handle, CacheRequestOutcome.ABORT)
+    if release_kv and (req.kv.holds_kv or req.kv.holds_mamba):
+        release_kv_cache(req, tree_cache, checkpoint=checkpoint)
+        # release_kv_cache closes the session after its optional STORE,
+        # including the Mamba-only path that has no device-KV row.
+        return
+    tree_cache.finish_request_session(handle)
+
+
 def release_kv_cache(req: Req, tree_cache: BasePrefixCache, *, checkpoint: bool):
     """Give the request's kv row back; with ``checkpoint`` the tree first keeps
     what it can key."""
@@ -407,6 +431,9 @@ def release_kv_cache(req: Req, tree_cache: BasePrefixCache, *, checkpoint: bool)
                 req.kv.mamba_pool_idx.unsqueeze(-1)
             )
             req.kv.mamba_pool_idx = None
+        # No cache_finished_req path runs, but cache backends may still own a
+        # per-request session opened during lookup.
+        tree_cache.finish_request_session(req.cache_request_handle)
         return
     if tree_cache.claim_kv_row(req):
         # A streaming session detached the kv record to keep the row.
@@ -437,6 +464,9 @@ def release_kv_cache(req: Req, tree_cache: BasePrefixCache, *, checkpoint: bool)
     # c4/c128 state pages; other ReqToTokenPool subclasses are a no-op here.
     tree_cache.req_to_token_pool.free(req)
     req.kv.mark_kv_released()
+    # Close backend session state after optional STORE. This is idempotent for
+    # LMCache and a no-op for cache backends without external sessions.
+    tree_cache.finish_request_session(req.cache_request_handle)
 
 
 def _release_overallocated_kv_indices(
