+class TestLMCacheRequestSession(unittest.TestCase):
+    def test_abort_after_lookup_finishes_session_once(self):
+        cache = _make_lmcache()
+        rid = "rid-abort"
+        handle = CacheRequestHandle(rid=rid, attempt_id=0)
+        _open_lookup(cache, rid)
+
+        cache.finish(handle, CacheRequestOutcome.ABORT)
+        self.assertNotIn(rid, cache._external_flows)
+        self.assertEqual(cache.lmcache_connector.finish_request_calls, [])
+
+        cache.finish_request_session(handle)
+        cache.finish_request_session(handle)
+        self.assertEqual(cache.lmcache_connector.finish_request_calls, [rid])
+        self.assertNotIn(rid, cache._open_sessions)
+
+    def test_abort_before_lookup_does_not_finish_session(self):
+        cache = _make_lmcache()
+        handle = CacheRequestHandle(rid="rid-never-matched", attempt_id=0)
+
+        cache.cancel_aborted_request_work(handle)
+        cache.finish_request_session(handle)
+
+        self.assertEqual(cache.lmcache_connector.finish_request_calls, [])
+
+    def test_finish_waits_for_pending_store(self):
+        cache = _make_lmcache()
+        rid = "rid-pending-store"
+        handle = CacheRequestHandle(rid=rid, attempt_id=0)
+        _open_lookup(cache, rid)
+        cache._pending_store_counts[rid] = 1
+
+        cache.finish_request_session(handle)
+        self.assertEqual(cache.lmcache_connector.finish_request_calls, [])
+        self.assertIn(rid, cache._session_finish_requested)
+
+        cache._pending_store_counts.pop(rid)
+        cache._finish_session_if_store_idle(rid)
+        self.assertEqual(cache.lmcache_connector.finish_request_calls, [rid])
+
+    def test_no_device_kv_release_still_finishes_session(self):
+        cache = _make_lmcache()
+        rid = "rid-mamba-only"
+        handle = CacheRequestHandle(rid=rid, attempt_id=0)
+        _open_lookup(cache, rid)
+
+        import torch
+
+        free = mock.Mock()
+        cache.supports_mamba = lambda: True
+        cache.req_to_token_pool = types.SimpleNamespace(
+            mamba_allocator=types.SimpleNamespace(free=free)
+        )
+        req = types.SimpleNamespace(
+            rid=rid,
+            cache_request_handle=handle,
+            kv=types.SimpleNamespace(
+                holds_kv=False,
+                holds_mamba=True,
+                is_kv_released=True,
+                mamba_pool_idx=torch.tensor([3]),
+            ),
+        )
+
+        release_kv_cache(req, cache, checkpoint=False)
+
+        free.assert_called_once()
+        self.assertIsNone(req.kv.mamba_pool_idx)
+        self.assertEqual(cache.lmcache_connector.finish_request_calls, [rid])
+
+
+class _FakeKv:
+    def __init__(self, *, holds_kv):
+        self.holds_kv = holds_kv
+        self.holds_mamba = False
+        self.is_kv_released = not holds_kv
+        self.cache_protected_len = 0
+        self.kv_allocated_len = 4 if holds_kv else 0
+        self.kv_committed_len = 4 if holds_kv else 0
+
+    def mark_kv_released(self):
+        self.holds_kv = False
+        self.is_kv_released = True
+
+
+class _RecordingCache:
+    def __init__(self):
+        self.ops = []
+        self.req_to_token_pool = types.SimpleNamespace(free=mock.Mock())
+        self.token_to_kv_pool_allocator = types.SimpleNamespace(page_size=1)
+
+    def finish(self, handle, outcome):
+        self.assert_outcome(outcome)
+        self.ops.append("cancel")
+
+    @staticmethod
+    def assert_outcome(outcome):
+        if outcome != CacheRequestOutcome.ABORT:
+            raise AssertionError(f"unexpected cache outcome: {outcome}")
+
+    def finish_request_session(self, handle):
+        self.ops.append("end_session")
+
+    def claim_kv_row(self, req):
+        return False
+
+    def checkpoint(self, req, *, up_to):
+        self.ops.append("store")
+
+    def free_kv_row(self, kv, ranges):
+        pass
+
+    def unlock(self, lock):
+        pass
+
+    def on_release(self, req, *, checkpointed):
+        pass
+
+    def supports_mamba(self):
+        return False
+
+
+def _make_abort_req(*, holds_kv):
+    rid = "rid-helper"
+    kv = _FakeKv(holds_kv=holds_kv)
+    req = types.SimpleNamespace(
+        rid=rid,
+        cache_request_handle=CacheRequestHandle(rid=rid, attempt_id=0),
+        kv=kv,
+        owned_kv_len=lambda: 4 if holds_kv else 0,
+        skip_radix_cache_insert=False,
+        finished=lambda: True,
+        refresh_fill_ids=lambda: None,
+        lock=object(),
+    )
+    return req
+
