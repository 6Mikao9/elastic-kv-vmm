+class TestAbortOrdering(unittest.TestCase):
+    def setUp(self):
+        self._runtime_patch = mock.patch.multiple(
+            "sglang.srt.mem_cache.common",
+            get_spec=lambda: types.SimpleNamespace(speculative_algorithm=None),
+            get_serving=lambda: types.SimpleNamespace(strip_thinking_cache=False),
+        )
+        self._runtime_patch.start()
+        self.addCleanup(self._runtime_patch.stop)
+
+    def test_abort_without_kv_closes_session_after_cancel(self):
+        cache = _RecordingCache()
+        abort_prefix_cache_request(_make_abort_req(holds_kv=False), cache)
+        self.assertEqual(cache.ops, ["cancel", "end_session"])
+
+    def test_abort_with_store_closes_session_last(self):
+        cache = _RecordingCache()
+        abort_prefix_cache_request(
+            _make_abort_req(holds_kv=True), cache, release_kv=True, checkpoint=True
+        )
+        self.assertEqual(cache.ops, ["cancel", "store", "end_session"])
+
+    def test_mamba_only_release_closes_session_once(self):
+        import torch
+
+        cache = _RecordingCache()
+        cache.supports_mamba = lambda: True
+        cache.req_to_token_pool = types.SimpleNamespace(
+            mamba_allocator=types.SimpleNamespace(free=mock.Mock())
+        )
+        req = _make_abort_req(holds_kv=False)
+        req.kv = types.SimpleNamespace(
+            holds_kv=False,
+            holds_mamba=True,
+            is_kv_released=True,
+            mamba_pool_idx=torch.tensor([3]),
+        )
+
+        abort_prefix_cache_request(
+            req, cache, release_kv=True, checkpoint=False
+        )
+
+        self.assertEqual(cache.ops, ["cancel", "end_session"])
+        cache.req_to_token_pool.mamba_allocator.free.assert_called_once()
+        self.assertIsNone(req.kv.mamba_pool_idx)
