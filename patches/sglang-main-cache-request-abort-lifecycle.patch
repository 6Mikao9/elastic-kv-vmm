+"""CPU regressions for two-phase cache-request abort cleanup.
+
+An abort first cancels lookup/prefetch work. KV may then be finalized into
+external storage, after which the backend request session is closed. FlexKV
+needs the first ordering so a store owns its source-node lock; LMCache needs
+the second so ``finish_request`` is not sent across a pending store.
+"""
+
+from __future__ import annotations
+
+import importlib
+import sys
+import threading
+import types
+import unittest
+from unittest import mock
+
+from sglang.srt.mem_cache.base_prefix_cache import (
+    CacheRequestHandle,
+    CacheRequestOutcome,
+)
+from sglang.srt.mem_cache.common import abort_prefix_cache_request, release_kv_cache
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+
+_LMCACHE_MODULE = "sglang.srt.mem_cache.storage.lmcache.lmcache_unified_radix_cache"
+_FLEXKV_MODULE = "sglang.srt.mem_cache.storage.flexkv.flexkv_radix_cache"
+
+
+def _install_lmcache_stubs():
+    modules = {}
+    for name in (
+        "lmcache",
+        "lmcache.integration",
+        "lmcache.integration.sglang",
+        "lmcache.integration.sglang.lmcache_mp_metadata",
+        "lmcache.integration.sglang.unified_lmcache_mp_connector",
+    ):
+        modules[name] = types.ModuleType(name)
+
+    class StubExternalFlow:
+        def __init__(self, *, key=None, lookup=None, total_hit=None):
+            self.key = key
+            self.lookup = lookup
+            self.total_hit = total_hit
+            self.local_hit_tokens = None
+            self.load = None
+            self.cancelled = False
+            self.mamba_value = None
+            self.load_req = None
+            self.retire_requested = False
+            self.load_completed = False
+            self.prefix_published = False
+            self.free_mamba_after_load = False
+
+    metadata = modules["lmcache.integration.sglang.lmcache_mp_metadata"]
+    metadata.LMCacheExternalFlow = StubExternalFlow
+    metadata.LMCachePendingStore = object
+    connector = modules["lmcache.integration.sglang.unified_lmcache_mp_connector"]
+    connector.UnifiedLMCacheMPConnector = object
+    return mock.patch.dict(sys.modules, modules)
+
+
+def _import_under_stubs(module_name, stub_factory):
+    was_imported = module_name in sys.modules
+    with stub_factory():
+        module = importlib.import_module(module_name)
+    if not was_imported:
+        sys.modules.pop(module_name, None)
+    return module
+
+
+LMCacheUnifiedRadixCache = _import_under_stubs(
+    _LMCACHE_MODULE, _install_lmcache_stubs
+).LMCacheUnifiedRadixCache
+
+
+class _FakeConnector:
+    def __init__(self):
+        self.finish_request_calls = []
+
+    def finish_request(self, request_id):
+        self.finish_request_calls.append(request_id)
+
+
+class _FakeFlow:
+    def __init__(self, *, total_hit=None):
+        self.key = None
+        self.lookup = types.SimpleNamespace(request_id="unused", lock_start=0)
+        self.total_hit = total_hit
+        self.local_hit_tokens = None
+        self.load = None
+        self.cancelled = False
+        self.mamba_value = None
+        self.load_req = None
+        self.retire_requested = False
+        self.load_completed = False
+        self.prefix_published = False
+        self.free_mamba_after_load = False
+
+
+def _make_lmcache():
+    cache = object.__new__(LMCacheUnifiedRadixCache)
+    cache._external_flows = {}
+    cache._pending_stores = []
+    cache._pending_store_counts = {}
+    cache._session_finish_requested = set()
+    cache._open_sessions = set()
+    cache.prefetch_loaded_tokens_by_reqid = {}
+    cache.prefetch_loaded_storage_start_by_reqid = {}
+    cache.lmcache_connector = _FakeConnector()
+    cache._retire_loaded_flow = mock.Mock()
+    cache._finish_failed_load = mock.Mock()
+    return cache
+
+
+def _open_lookup(cache, rid, *, total_hit=None):
+    cache._open_sessions.add(rid)
+    cache._external_flows[rid] = _FakeFlow(total_hit=total_hit)
+
