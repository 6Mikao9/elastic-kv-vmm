diff --git a/test/registered/unit/managers/test_kv_hints.py b/test/registered/unit/managers/test_kv_hints.py
new file mode 100644
index 0000000000000000000000000000000000000000..b2a66f0d5b59a56e30822266b48a831cf6a473a4
--- /dev/null
+++ b/test/registered/unit/managers/test_kv_hints.py
@@ -0,0 +1,157 @@
+import importlib.util
+import pickle
+import sys
+from pathlib import Path
+
+import pytest
+
+_KV_HINTS_PATH = (
+    Path(__file__).parents[4] / "python/sglang/srt/managers/kv_hints.py"
+)
+_SPEC = importlib.util.spec_from_file_location("native_kv_hints", _KV_HINTS_PATH)
+assert _SPEC is not None and _SPEC.loader is not None
+kv_hints = importlib.util.module_from_spec(_SPEC)
+sys.modules[_SPEC.name] = kv_hints
+_SPEC.loader.exec_module(kv_hints)
+
+SUPPORTED_PROTOCOL_VERSION = kv_hints.SUPPORTED_PROTOCOL_VERSION
+KvHintAction = kv_hints.KvHintAction
+KvHintsEnvelope = kv_hints.KvHintsEnvelope
+decode_kv_hints_envelope = kv_hints.decode_kv_hints_envelope
+normalize_single_kv_hints = kv_hints.normalize_single_kv_hints
+normalize_batch_kv_hints = kv_hints.normalize_batch_kv_hints
+
+
+ENVELOPE = {
+    "protocol_version": "1",
+    "message_id": "msg-1",
+    "actions": [
+        {
+            "action_id": "future-1",
+            "action_type": "elastic.future",
+            "action_version": "1",
+            "payload": {"deadline_after_ms": 500},
+        }
+    ],
+}
+
+
+def test_envelope_is_validated_and_pickle_safe():
+    envelope = decode_kv_hints_envelope(ENVELOPE)
+
+    assert envelope.protocol_version == SUPPORTED_PROTOCOL_VERSION
+    assert isinstance(envelope.actions[0], KvHintAction)
+    assert pickle.loads(pickle.dumps(envelope)) == envelope
+    assert decode_kv_hints_envelope(envelope).message_id == "msg-1"
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        None,
+        {},
+        {"protocol_version": "999", "message_id": "m", "actions": []},
+        {"protocol_version": "", "message_id": "m", "actions": []},
+        {"protocol_version": "1", "message_id": "", "actions": []},
+        {"protocol_version": "1", "message_id": "m"},
+        {"protocol_version": "1", "message_id": "m", "actions": None},
+        {"protocol_version": "1", "message_id": "m", "actions": {}},
+        {
+            "protocol_version": "1",
+            "message_id": "m",
+            "actions": [{"action_id": "a"}],
+        },
+        {
+            "protocol_version": "1",
+            "message_id": "m",
+            "actions": [
+                {
+                    "action_id": "",
+                    "action_type": "elastic.future",
+                    "action_version": "1",
+                }
+            ],
+        },
+    ],
+)
+def test_rejects_malformed_envelopes_and_actions(value):
+    with pytest.raises(ValueError):
+        decode_kv_hints_envelope(value)
+
+
+def test_rejects_malformed_typed_action():
+    envelope = KvHintsEnvelope(
+        protocol_version="1",
+        message_id="m",
+        actions=[KvHintAction("", "elastic.future", "1")],
+    )
+
+    with pytest.raises(ValueError, match="action_id"):
+        decode_kv_hints_envelope(envelope)
+
+
+def test_single_request_normalizes_hint():
+    assert normalize_single_kv_hints(ENVELOPE).message_id == "msg-1"
+    assert normalize_single_kv_hints(None) is None
+
+
+@pytest.mark.parametrize("value", [{}, 0, "", False])
+def test_falsy_malformed_single_hint_is_not_silently_ignored(value):
+    with pytest.raises(ValueError):
+        normalize_single_kv_hints(value)
+
+
+def test_batch_broadcast_and_per_item_hints():
+    broadcast = normalize_batch_kv_hints(
+        ENVELOPE,
+        batch_size=2,
+        expanded_size=2,
+        parallel_sample_num=1,
+    )
+    assert [broadcast[i].message_id for i in range(2)] == [
+        "msg-1",
+        "msg-1",
+    ]
+
+    second = dict(ENVELOPE)
+    second["message_id"] = "msg-2"
+    per_item = normalize_batch_kv_hints(
+        [ENVELOPE, second],
+        batch_size=2,
+        expanded_size=2,
+        parallel_sample_num=1,
+    )
+    assert [per_item[i].message_id for i in range(2)] == [
+        "msg-1",
+        "msg-2",
+    ]
+
+
+@pytest.mark.parametrize(
+    ("text", "hints"),
+    [
+        (["a", "b"], [ENVELOPE]),
+        (["a", "b"], [None, {}]),
+        (["a", "b"], [None, False]),
+    ],
+)
+def test_batch_rejects_partial_or_falsy_placeholders(text, hints):
+    with pytest.raises(ValueError):
+        normalize_batch_kv_hints(
+            hints,
+            batch_size=len(text),
+            expanded_size=len(text),
+            parallel_sample_num=1,
+        )
+
+
+def test_parallel_sampling_expands_one_hint_per_generated_item():
+    hints = normalize_batch_kv_hints(
+        ENVELOPE,
+        batch_size=2,
+        expanded_size=4,
+        parallel_sample_num=2,
+    )
+
+    assert len(hints) == 4
+    assert all(hint.message_id == "msg-1" for hint in hints)
