+# SPDX-License-Identifier: Apache-2.0
+"""Versioned KV-hint envelope carried on a request.
+
+The envelope is deliberately transport-only. Each action identifies its own
+type and version; a consumer ignores actions it does not implement and
+validates the payload of actions it handles.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Dict, List
+
+SUPPORTED_PROTOCOL_VERSION = "1"
+_MAX_IDENTIFIER_LENGTH = 512
+
+
+@dataclass(frozen=True)
+class KvHintAction:
+    """One versioned action inside a KV-hint envelope."""
+
+    action_id: str
+    action_type: str
+    action_version: str
+    payload: Dict[str, Any] = field(default_factory=dict)
+
+
+@dataclass(frozen=True)
+class KvHintsEnvelope:
+    """Orchestrator-provided KV hints attached to one request."""
+
+    protocol_version: str
+    message_id: str
+    actions: List[KvHintAction] = field(default_factory=list)
+
+
+def _require_string(value: Any, field_name: str) -> str:
+    if (
+        not isinstance(value, str)
+        or not value
+        or len(value) > _MAX_IDENTIFIER_LENGTH
+    ):
+        raise ValueError(
+            f"kv_hints.{field_name} must be a non-empty string of at most "
+            f"{_MAX_IDENTIFIER_LENGTH} characters"
+        )
+    return value
+
+
+def _decode_action(value: Any, index: int) -> KvHintAction:
+    if isinstance(value, KvHintAction):
+        action_id = value.action_id
+        action_type = value.action_type
+        action_version = value.action_version
+        payload = value.payload
+    elif isinstance(value, dict):
+        try:
+            action_id = value.get("action_id")
+            action_type = value.get("action_type")
+            action_version = value.get("action_version")
+            payload = value.get("payload", {})
+        except AttributeError as exc:
+            raise ValueError(
+                f"kv_hints.actions[{index}] must be an object"
+            ) from exc
+    else:
+        raise ValueError(f"kv_hints.actions[{index}] must be an object")
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        raise ValueError(f"kv_hints.actions[{index}].payload must be an object")
+    return KvHintAction(
+        action_id=_require_string(action_id, f"actions[{index}].action_id"),
+        action_type=_require_string(action_type, f"actions[{index}].action_type"),
+        action_version=_require_string(
+            action_version, f"actions[{index}].action_version"
+        ),
+        payload=dict(payload),
+    )
+
+
+def decode_kv_hints_envelope(value: Any) -> KvHintsEnvelope:
+    """Convert a JSON-compatible envelope into the internal typed form.
+
+    Unknown top-level and action keys are ignored so that a newer orchestrator
+    can add fields without breaking an older transport. Missing or mistyped
+    required fields are rejected at the request boundary.
+    """
+    if isinstance(value, KvHintsEnvelope):
+        protocol_version = value.protocol_version
+        message_id = value.message_id
+        actions = value.actions
+    elif isinstance(value, dict):
+        protocol_version = value.get("protocol_version")
+        message_id = value.get("message_id")
+        actions = value.get("actions")
+    else:
+        raise ValueError("kv_hints must be an object")
+
+    if protocol_version != SUPPORTED_PROTOCOL_VERSION:
+        raise ValueError(
+            "kv_hints.protocol_version must be "
+            f"{SUPPORTED_PROTOCOL_VERSION!r}"
+        )
+    if not isinstance(actions, list):
+        raise ValueError("kv_hints.actions must be an array")
+
+    return KvHintsEnvelope(
+        protocol_version=SUPPORTED_PROTOCOL_VERSION,
+        message_id=_require_string(message_id, "message_id"),
+        actions=[_decode_action(action, i) for i, action in enumerate(actions)],
+    )
+
+
+def normalize_single_kv_hints(value: Any) -> KvHintsEnvelope | None:
+    """Normalize the hint on one request, using only ``None`` for no hint."""
+    if isinstance(value, list):
+        raise ValueError("kv_hints should be a single envelope for one request.")
+    return decode_kv_hints_envelope(value) if value is not None else None
+
+
+def normalize_batch_kv_hints(
+    value: Any,
+    *,
+    batch_size: int,
+    expanded_size: int,
+    parallel_sample_num: int,
+) -> list[KvHintsEnvelope | None] | None:
+    """Normalize a broadcast hint or one hint per unexpanded batch item."""
+    if value is None:
+        return None
+    if isinstance(value, (dict, KvHintsEnvelope)):
+        return [decode_kv_hints_envelope(value)] * expanded_size
+    if not isinstance(value, list):
+        raise ValueError("kv_hints should be a list or a dict.")
+    if len(value) != batch_size:
+        raise ValueError("The length of kv_hints should be equal to the batch size.")
+    normalized = [
+        decode_kv_hints_envelope(item) if item is not None else None
+        for item in value
+    ]
+    return normalized * parallel_sample_num
